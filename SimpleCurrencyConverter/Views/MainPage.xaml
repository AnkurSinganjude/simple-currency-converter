<Page
    x:Class="SimpleCurrencyConverter.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4" Padding="40,32,40,40"
                    HorizontalAlignment="Center" Width="600">

            <!-- Banners -->
            <InfoBar x:Name="OfflineBanner"
                     Title="Offline Mode"
                     Message="Using cached exchange rates. Rates may not be current."
                     Severity="Warning"
                     IsOpen="False"
                     IsClosable="False"
                     Margin="0,0,0,8" />
            <InfoBar x:Name="ErrorBanner"
                     Title="Error"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,0,0,8" />

            <!-- Header with gradient icon -->
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,8">
                <Border CornerRadius="12" Width="48" Height="48">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0.0" />
                            <GradientStop Color="#8B5CF6" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon Glyph="&#xE8CB;" FontSize="22" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="Currency Converter"
                               FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Real-time exchange rates"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Main Converter Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28,24,28,28">
                <StackPanel Spacing="20">

                    <!-- From Section -->
                    <Border CornerRadius="10" Padding="20,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1A3B82F6" Offset="0.0" />
                                <GradientStop Color="#0D3B82F6" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#333B82F6" />
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#3B82F6" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="FROM" FontSize="10" FontWeight="Bold"
                                               CharacterSpacing="80" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <ComboBox x:Name="FromCurrencyBox"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Select currency"
                                      SelectionChanged="FromCurrency_SelectionChanged" />
                            <NumberBox x:Name="AmountBox"
                                       Value="1"
                                       Minimum="0"
                                       SpinButtonPlacementMode="Hidden"
                                       PlaceholderText="Enter amount"
                                       ValueChanged="AmountBox_ValueChanged"
                                       HorizontalAlignment="Stretch"
                                       FontSize="28"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Swap Button -->
                    <Button x:Name="SwapButton"
                            HorizontalAlignment="Center"
                            Click="SwapButton_Click"
                            ToolTipService.ToolTip="Swap currencies"
                            Width="44" Height="44"
                            CornerRadius="22"
                            Padding="0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0.0" />
                                <GradientStop Color="#8B5CF6" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <FontIcon Glyph="&#xE74B;" FontSize="18" Foreground="White" />
                    </Button>

                    <!-- To Section -->
                    <Border CornerRadius="10" Padding="20,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1A10B981" Offset="0.0" />
                                <GradientStop Color="#0D10B981" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#3310B981" />
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#10B981" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="TO" FontSize="10" FontWeight="Bold"
                                               CharacterSpacing="80" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <ComboBox x:Name="ToCurrencyBox"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Select currency"
                                      SelectionChanged="ToCurrency_SelectionChanged" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Loading -->
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"
                         Margin="0,4,0,0" />

            <!-- Result Card -->
            <Border x:Name="ResultCard"
                    CornerRadius="12"
                    Padding="28,24"
                    Margin="0,4,0,0"
                    Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6366F1" Offset="0.0" />
                        <GradientStop Color="#8B5CF6" Offset="0.5" />
                        <GradientStop Color="#A78BFA" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock x:Name="ConvertedAmountText"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock x:Name="RateText"
                                   FontSize="13"
                                   Foreground="#E0E0E0" />
                        <TextBlock x:Name="LastUpdatedText"
                                   FontSize="11"
                                   Foreground="#B0B0B0" />
                    </StackPanel>

                    <Button x:Name="FavoriteButton"
                            Grid.Column="1"
                            Click="FavoriteButton_Click"
                            VerticalAlignment="Top"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Padding="0"
                            Background="#33FFFFFF"
                            BorderBrush="Transparent"
                            ToolTipService.ToolTip="Toggle favorite">
                        <FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" FontSize="20"
                                  Foreground="White" />
                    </Button>
                </Grid>
            </Border>

            <!-- Favorites Section -->
            <Border x:Name="FavoritesSection"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28,20,28,12"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="4" Padding="6,2">
                            <Border.Background>
                                <SolidColorBrush Color="#F59E0B" />
                            </Border.Background>
                            <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="White" />
                        </Border>
                        <TextBlock Text="Favorites"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <ListView x:Name="FavoritesList"
                              SelectionMode="Single"
                              SelectionChanged="FavoritesList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8AB;" FontSize="14"
                                              Foreground="#F59E0B" />
                                    <TextBlock Grid.Column="1" Text="{Binding}"
                                               VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
